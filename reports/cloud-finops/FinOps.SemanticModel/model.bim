        ],
        "measures": [
          {
            "name": "Annual Spend",
            "expression": "CALCULATE(SUM(Spend[AllocatedCost]), TREATAS({SELECTEDVALUE(Scenarios[Scenario], \"Moderate\")}, Spend[Scenario]))",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Baseline Actual",
            "expression": "CALCULATE(SUM(Spend[BaselineAllocatedCost]), TREATAS({SELECTEDVALUE(Scenarios[Scenario], \"Moderate\")}, Spend[Scenario]))",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Budget",
            "expression": "CALCULATE(SUM(Spend[Budget]), TREATAS({SELECTEDVALUE(Scenarios[Scenario], \"Moderate\")}, Spend[Scenario]))",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Budget Variance",
            "expression": "[Annual Spend] - [Budget]",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Variance Percent",
            "expression": "DIVIDE([Budget Variance], [Budget])",
            "formatString": "0.0%"
          },
          {
            "name": "Annual Savings",
            "expression": "[Baseline Actual] - [Annual Spend]",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Savings Percent",
            "expression": "DIVIDE([Annual Savings], [Baseline Actual])",
            "formatString": "0.0%"
          },
          {
            "name": "Direct Cost",
            "expression": "CALCULATE(SUM(Spend[OptimizedDirectCost]), TREATAS({SELECTEDVALUE(Scenarios[Scenario], \"Moderate\")}, Spend[Scenario]))",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Shared Cost",
            "expression": "CALCULATE(SUM(Spend[SharedCost]), TREATAS({SELECTEDVALUE(Scenarios[Scenario], \"Moderate\")}, Spend[Scenario]))",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Used Capacity",
            "expression": "CALCULATE(SUM(Spend[UsedCapacity]), TREATAS({SELECTEDVALUE(Scenarios[Scenario], \"Moderate\")}, Spend[Scenario]))",
            "formatString": "0.0"
          },
          {
            "name": "Remaining Capacity",
            "expression": "CALCULATE(SUM(Spend[RemainingCapacity]), TREATAS({SELECTEDVALUE(Scenarios[Scenario], \"Moderate\")}, Spend[Scenario]))",
            "formatString": "0.0"
          },
          {
            "name": "Compute Utilization",
            "expression": "DIVIDE([Used Capacity], [Remaining Capacity])",
            "formatString": "0.0%"
          },
          {
            "name": "Workload Units",
            "expression": "CALCULATE(SUM(Spend[WorkloadUnits]), TREATAS({SELECTEDVALUE(Scenarios[Scenario], \"Moderate\")}, Spend[Scenario]))",
            "formatString": "#,0"
          },
          {
            "name": "Cost Per Workload Unit",
            "expression": "DIVIDE([Annual Spend], [Workload Units])",
            "formatString": "$0.000"
          },
          {
            "name": "Eligible Basis",
            "expression": "CALCULATE(SUM(Spend[EligibleCostBasis]), TREATAS({SELECTEDVALUE(Scenarios[Scenario], \"Moderate\")}, Spend[Scenario]))",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Committed Basis",
            "expression": "CALCULATE(SUM(Spend[ReservedCostBasis]), TREATAS({SELECTEDVALUE(Scenarios[Scenario], \"Moderate\")}, Spend[Scenario]))",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Eligible Coverage",
            "expression": "DIVIDE([Committed Basis], [Eligible Basis], 0)",
            "formatString": "0.0%"
          },
          {
            "name": "Minimum Buffer",
            "expression": "CALCULATE(MIN(Spend[CapacityBuffer]), Spend[RemainingCapacity] > 0, TREATAS({SELECTEDVALUE(Scenarios[Scenario], \"Moderate\")}, Spend[Scenario]))",
            "formatString": "0.0%"
          },
          {
            "name": "Idle Savings",
            "expression": "CALCULATE(SUM(Spend[IdleSavings]), TREATAS({SELECTEDVALUE(Scenarios[Scenario], \"Moderate\")}, Spend[Scenario]))",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Rightsizing Savings",
            "expression": "CALCULATE(SUM(Spend[RightsizingSavings]), TREATAS({SELECTEDVALUE(Scenarios[Scenario], \"Moderate\")}, Spend[Scenario]))",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Storage Savings",
            "expression": "CALCULATE(SUM(Spend[StorageSavings]), TREATAS({SELECTEDVALUE(Scenarios[Scenario], \"Moderate\")}, Spend[Scenario]))",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Reservation Savings",
            "expression": "CALCULATE(SUM(Spend[ReservationSavings]), TREATAS({SELECTEDVALUE(Scenarios[Scenario], \"Moderate\")}, Spend[Scenario]))",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Forecast Spend",
            "expression": "CALCULATE(SUM(Forecast[ForecastCost]), TREATAS({SELECTEDVALUE(Scenarios[Scenario], \"Moderate\")}, Forecast[Scenario]))",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Forecast Budget",
            "expression": "CALCULATE(SUM(Forecast[ForecastBudget]), TREATAS({SELECTEDVALUE(Scenarios[Scenario], \"Moderate\")}, Forecast[Scenario]))",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Forecast Variance",
            "expression": "[Forecast Spend] - [Forecast Budget]",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Exit Run Rate",
            "expression": "CALCULATE([Annual Spend], Spend[Month] = \"2026-12\") * 12",
            "formatString": "$#,0;($#,0)"
          }
        ]
      },
