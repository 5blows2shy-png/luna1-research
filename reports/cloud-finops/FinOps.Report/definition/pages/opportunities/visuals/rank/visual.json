{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.1.0/schema.json",
  "name": "rank",
  "position": {
    "x": 32,
    "y": 210,
    "z": 1,
    "width": 1528,
    "height": 360,
    "tabOrder": 242
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Workloads"
                    }
                  },
                  "Property": "Workload"
                }
              },
              "queryRef": "Workloads.Workload",
              "displayName": "Workload"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Spend"
                    }
                  },
                  "Property": "Annual Savings"
                }
              },
              "queryRef": "Spend.Annual Savings",
              "displayName": "Annual Savings"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "Spend"
                  }
                },
                "Property": "Annual Savings"
              }
            },
            "direction": "Descending"
          }
        ]
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Top 10 cloud optimization opportunities'"
                }
              }
            },
            "fontColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#F1EDE4'"
                    }
                  }
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "12"
                }
              }
            }
          }
        }
      ]
    }
  }
}
