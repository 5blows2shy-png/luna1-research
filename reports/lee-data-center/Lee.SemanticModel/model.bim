            "name": "Power Expense",
            "expression": "IF(HASONEVALUE(Power[Power_Price]),SELECTEDVALUE(Power[Exit_Power_Cost]),BLANK())",
            "formatString": "$#,0"
          },
          {
            "name": "Power EBITDA",
            "expression": "IF(HASONEVALUE(Power[Power_Price]),SELECTEDVALUE(Power[Exit_EBITDA]),BLANK())",
            "formatString": "$#,0"
          },
          {
            "name": "Power Equity IRR",
            "expression": "IF(HASONEVALUE(Power[Power_Price]),SELECTEDVALUE(Power[Equity_IRR]),BLANK())",
            "formatString": "0.0%"
          },
          {
            "name": "Power Minimum DSCR",
            "expression": "IF(HASONEVALUE(Power[Power_Price]),SELECTEDVALUE(Power[Minimum_DSCR]),BLANK())",
            "formatString": "0.00\"x\""
          },
          {
            "name": "Power Equity NPV",
            "expression": "IF(HASONEVALUE(Power[Power_Price]),SELECTEDVALUE(Power[Equity_NPV]),BLANK())",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Power Breach Years",
            "expression": "IF(HASONEVALUE(Power[Power_Price]),SELECTEDVALUE(Power[Breach_Years]),BLANK())",
            "formatString": "0"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "Scenario relationship",
        "fromTable": "Annual",
        "fromColumn": "Scenario",
        "toTable": "Results",
        "toColumn": "Scenario",
        "crossFilteringBehavior": "oneDirection"
      }
    ]
  }
}
