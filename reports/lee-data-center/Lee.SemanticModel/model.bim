                "  {\"Base\", 0.16181118197176036, 3.495071441673298, 0.14296450110060144, 2.8908429413296455, 6846060.0887945, 0.5044384034210088, 94709162.09528461, 331015287.7040365, 65471400, 6},",
                "  {\"Upside\", 0.23745060630853254, 6.060283148400757, 0.19994691428792766, 4.276110898456446, 57361720.93012686, 0.7675400046080189, 80251806.80066964, 486348672.3828114, 62447400, 3},",
