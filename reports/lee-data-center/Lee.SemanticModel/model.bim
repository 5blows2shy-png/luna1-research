          {
            "name": "Equity MOIC",
            "expression": "IF(HASONEVALUE(Results[Scenario]), SELECTEDVALUE(Results[Equity_MOIC]), BLANK())",
            "formatString": "0.00\"x\""
          },
          {
            "name": "Minimum DSCR",
            "expression": "IF(HASONEVALUE(Results[Scenario]), SELECTEDVALUE(Results[Minimum_DSCR]), BLANK())",
            "formatString": "0.00\"x\""
          },
          {
            "name": "Breach years",
            "expression": "IF(HASONEVALUE(Results[Scenario]), SELECTEDVALUE(Results[Covenant_Breach_Years]), BLANK())",
            "formatString": "0"
          },
          {
            "name": "Equity NPV",
            "expression": "IF(HASONEVALUE(Results[Scenario]), SELECTEDVALUE(Results[Equity_NPV]), BLANK())",
