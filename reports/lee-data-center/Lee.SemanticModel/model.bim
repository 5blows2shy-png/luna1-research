        "measures": [
          {
            "name": "Revenue",
            "expression": "IF(NOT(ISFILTERED(Results[Scenario])),CALCULATE(SUM(Annual[Revenue]),Results[Scenario]=\"Base\"),IF(HASONEVALUE(Results[Scenario]),SUM(Annual[Revenue]),BLANK()))",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "EBITDA",
            "expression": "IF(NOT(ISFILTERED(Results[Scenario])),CALCULATE(SUM(Annual[EBITDA]),Results[Scenario]=\"Base\"),IF(HASONEVALUE(Results[Scenario]),SUM(Annual[EBITDA]),BLANK()))",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Power Cost",
            "expression": "IF(NOT(ISFILTERED(Results[Scenario])),CALCULATE(SUM(Annual[Power_Cost]),Results[Scenario]=\"Base\"),IF(HASONEVALUE(Results[Scenario]),SUM(Annual[Power_Cost]),BLANK()))",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "CFADS",
            "expression": "IF(NOT(ISFILTERED(Results[Scenario])),CALCULATE(SUM(Annual[CFADS]),Results[Scenario]=\"Base\"),IF(HASONEVALUE(Results[Scenario]),SUM(Annual[CFADS]),BLANK()))",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Debt Service",
            "expression": "IF(NOT(ISFILTERED(Results[Scenario])),CALCULATE(SUM(Annual[Debt_Service]),Results[Scenario]=\"Base\"),IF(HASONEVALUE(Results[Scenario]),SUM(Annual[Debt_Service]),BLANK()))",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Interest",
            "expression": "IF(NOT(ISFILTERED(Results[Scenario])),CALCULATE(SUM(Annual[Interest]),Results[Scenario]=\"Base\"),IF(HASONEVALUE(Results[Scenario]),SUM(Annual[Interest]),BLANK()))",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Principal",
            "expression": "IF(NOT(ISFILTERED(Results[Scenario])),CALCULATE(SUM(Annual[Principal]),Results[Scenario]=\"Base\"),IF(HASONEVALUE(Results[Scenario]),SUM(Annual[Principal]),BLANK()))",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Ending Debt",
            "expression": "IF(HASONEVALUE(Annual[Year]),IF(NOT(ISFILTERED(Results[Scenario])),CALCULATE(SUM(Annual[Ending_Debt]),Results[Scenario]=\"Base\"),IF(HASONEVALUE(Results[Scenario]),SUM(Annual[Ending_Debt]),BLANK())),BLANK())",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Equity Cash Flow",
            "expression": "IF(NOT(ISFILTERED(Results[Scenario])),CALCULATE(SUM(Annual[Equity_Cash_Flow]),Results[Scenario]=\"Base\"),IF(HASONEVALUE(Results[Scenario]),SUM(Annual[Equity_Cash_Flow]),BLANK()))",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Debt Draw",
            "expression": "IF(NOT(ISFILTERED(Results[Scenario])),CALCULATE(SUM(Annual[Debt_Draw]),Results[Scenario]=\"Base\"),IF(HASONEVALUE(Results[Scenario]),SUM(Annual[Debt_Draw]),BLANK()))",
            "formatString": "$#,0;($#,0)"
          }
        ]
      },
