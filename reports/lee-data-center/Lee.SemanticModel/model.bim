        "measures": [
          {
            "name": "Revenue",
            "expression": "IF(HASONEVALUE(Results[Scenario]), SUM(Annual[Revenue]), BLANK())",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "EBITDA",
            "expression": "IF(HASONEVALUE(Results[Scenario]), SUM(Annual[EBITDA]), BLANK())",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Power Cost",
            "expression": "IF(HASONEVALUE(Results[Scenario]), SUM(Annual[Power_Cost]), BLANK())",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "CFADS",
            "expression": "IF(HASONEVALUE(Results[Scenario]), SUM(Annual[CFADS]), BLANK())",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Debt Service",
            "expression": "IF(HASONEVALUE(Results[Scenario]), SUM(Annual[Debt_Service]), BLANK())",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Interest",
            "expression": "IF(HASONEVALUE(Results[Scenario]), SUM(Annual[Interest]), BLANK())",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Principal",
            "expression": "IF(HASONEVALUE(Results[Scenario]), SUM(Annual[Principal]), BLANK())",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Ending Debt",
            "expression": "IF(HASONEVALUE(Results[Scenario]), SUM(Annual[Ending_Debt]), BLANK())",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Equity Cash Flow",
            "expression": "IF(HASONEVALUE(Results[Scenario]), SUM(Annual[Equity_Cash_Flow]), BLANK())",
            "formatString": "$#,0;($#,0)"
          },
          {
            "name": "Debt Draw",
            "expression": "IF(HASONEVALUE(Results[Scenario]), SUM(Annual[Debt_Draw]), BLANK())",
            "formatString": "$#,0;($#,0)"
          }
        ]
      }
