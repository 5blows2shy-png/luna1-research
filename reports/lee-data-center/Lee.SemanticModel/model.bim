        "measures": [
          {
            "name": "Equity IRR",
            "expression": "IF(NOT(ISFILTERED(Results[Scenario])),CALCULATE(SELECTEDVALUE(Results[Equity_IRR]),Results[Scenario]=\"Base\"),IF(HASONEVALUE(Results[Scenario]),SELECTEDVALUE(Results[Equity_IRR]),BLANK()))",
            "formatString": "0.0%"
          },
          {
            "name": "Equity MOIC",
            "expression": "IF(NOT(ISFILTERED(Results[Scenario])),CALCULATE(SELECTEDVALUE(Results[Equity_MOIC]),Results[Scenario]=\"Base\"),IF(HASONEVALUE(Results[Scenario]),SELECTEDVALUE(Results[Equity_MOIC]),BLANK()))",
            "formatString": "0.00\"x\""
          },
          {
            "name": "Minimum DSCR",
            "expression": "IF(NOT(ISFILTERED(Results[Scenario])),CALCULATE(SELECTEDVALUE(Results[Minimum_DSCR]),Results[Scenario]=\"Base\"),IF(HASONEVALUE(Results[Scenario]),SELECTEDVALUE(Results[Minimum_DSCR]),BLANK()))",
            "formatString": "0.00\"x\""
          },
          {
            "name": "Breach years",
            "expression": "IF(NOT(ISFILTERED(Results[Scenario])),CALCULATE(SELECTEDVALUE(Results[Covenant_Breach_Years]),Results[Scenario]=\"Base\"),IF(HASONEVALUE(Results[Scenario]),SELECTEDVALUE(Results[Covenant_Breach_Years]),BLANK()))",
            "formatString": "0"
          },
          {
            "name": "Equity NPV",
            "expression": "IF(NOT(ISFILTERED(Results[Scenario])),CALCULATE(SELECTEDVALUE(Results[Equity_NPV]),Results[Scenario]=\"Base\"),IF(HASONEVALUE(Results[Scenario]),SELECTEDVALUE(Results[Equity_NPV]),BLANK()))",
            "formatString": "$#,0;($#,0)"
          }
        ]
      },
